# Application
APP_NAME=LeadHunter
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=leadhunter
POSTGRES_PASSWORD=leadhunter_secret
POSTGRES_DB=leadhunter

# SQLAlchemy (auto-built from POSTGRES_* if not set)
DATABASE_URL=postgresql+asyncpg://leadhunter:leadhunter_secret@db:5432/leadhunter

# OpenRouter (future integration — not implemented yet)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Playwright
PLAYWRIGHT_HEADLESS=true

# Scoring
SCORING_RULES_PATH=app/config/scoring_rules.json

# 2GIS Places API (dev.2gis.com)
DGIS_API_KEY=
